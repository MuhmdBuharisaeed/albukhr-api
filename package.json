{
  "name": "albukhr-api",
  "version": "2.3.0",
  "private": true,
  "description": "ALBUKHR Mainnet API and trusted service gateways",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-syntax.js",
    "test": "npm run check && npm run test:offline",
    "test:offline": "node scripts/run-offline-tests.js",
    "test:cross-repo": "node scripts/run-cross-repo-tests.js",
    "test:financial-readiness": "node --test test/mainnet-financial-readiness.test.js test/published-term-projection.test.js",
    "test:staking-policy-acceptance": "node --test test/staking-policy-acceptance-core.test.js",
    "test:staking-durations": "node --test test/staking-duration-catalogue.test.js",
    "test:project-updates": "node --test test/project-updates-validation.test.js",
    "test:project-updates-access": "node --test test/project-updates-admin-access.test.js",
    "test:wallet": "node --test test/wallet-balance-service.test.js",
    "test:project-updates-cleanup": "node --test test/project-updates-cleanup-client.test.js",
    "cleanup:project-updates": "node scripts/project-updates-cleanup.js"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "stellar-sdk": "^13.3.0"
  }
}
