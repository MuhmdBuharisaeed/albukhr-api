CREATE TABLE albukhr_security.financial_control_role_change_requests (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  network text NOT NULL DEFAULT 'mainnet',
  request_type text NOT NULL,
  role_code text NOT NULL REFERENCES albukhr_security.financial_control_role_catalog(role_code) ON DELETE RESTRICT,
  target_user_id uuid NOT NULL REFERENCES albukhr_security.admin_users(user_id) ON DELETE RESTRICT,
  scope_type text NOT NULL,
  project_id uuid REFERENCES public.projects(id) ON DELETE RESTRICT,
  target_grant_id uuid,
  reason text NOT NULL,
  requested_by uuid NOT NULL REFERENCES albukhr_security.admin_users(user_id) ON DELETE RESTRICT,
  requested_at timestamptz NOT NULL DEFAULT now(),
  status text NOT NULL DEFAULT 'pending_second_approval',
  approved_by uuid REFERENCES albukhr_security.admin_users(user_id) ON DELETE RESTRICT,
  approved_at timestamptz,
  rejected_by uuid REFERENCES albukhr_security.admin_users(user_id) ON DELETE RESTRICT,
  rejected_at timestamptz,
  rejection_reason text,
  CONSTRAINT financial_control_requests_network_ck CHECK (network = 'mainnet'),
  CONSTRAINT financial_control_requests_type_ck CHECK (request_type IN ('grant','revoke')),
  CONSTRAINT financial_control_requests_scope_ck CHECK (
    (scope_type = 'global' AND project_id IS NULL) OR
    (scope_type = 'project' AND project_id IS NOT NULL)
  ),
  CONSTRAINT financial_control_requests_status_ck CHECK (
    status IN ('pending_second_approval','approved','rejected')
  ),
  CONSTRAINT financial_control_requests_reason_ck CHECK (length(btrim(reason)) BETWEEN 10 AND 2000),
  CONSTRAINT financial_control_requests_revoke_target_ck CHECK (
    (request_type = 'grant' AND target_grant_id IS NULL) OR
    (request_type = 'revoke' AND target_grant_id IS NOT NULL)
  ),
  CONSTRAINT financial_control_requests_approval_ck CHECK (
    (status <> 'approved' OR
      (approved_by IS NOT NULL AND approved_at IS NOT NULL
       AND approved_by <> requested_by AND approved_by <> target_user_id))
  ),
  CONSTRAINT financial_control_requests_rejection_ck CHECK (
    (status <> 'rejected' OR
      (rejected_by IS NOT NULL AND rejected_at IS NOT NULL
       AND rejection_reason IS NOT NULL
       AND rejected_by <> requested_by AND rejected_by <> target_user_id))
  ),
  CONSTRAINT financial_control_requests_no_double_resolution_ck CHECK (
    NOT (approved_by IS NOT NULL AND rejected_by IS NOT NULL)
  )
);

CREATE TABLE albukhr_security.financial_control_role_grants (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
