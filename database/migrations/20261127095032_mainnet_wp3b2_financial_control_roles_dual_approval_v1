  CONSTRAINT financial_control_role_catalog_scope_ck
    CHECK (scope_mode IN ('global_only','project_only','global_or_project')),
  CONSTRAINT financial_control_role_catalog_name_ck
    CHECK (length(btrim(display_name)) BETWEEN 2 AND 100),
  CONSTRAINT financial_control_role_catalog_description_ck
    CHECK (length(btrim(description)) BETWEEN 10 AND 1000)
);

